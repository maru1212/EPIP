# PostgreSQL connection string used by Prisma (migrations and the app).
# Local development default matches the docs in prisma/README.md.
DATABASE_URL="postgresql://epip:epip_dev_password@localhost:5432/epip_dev?schema=public"

# Auth.js (next-auth v5). Generate a real secret with:
#   openssl rand -base64 32
# Required in every environment. In production (NODE_ENV=production), it is
# also rejected if it's shorter than 32 characters or matches a known
# placeholder value (see src/lib/env.ts) — this file's default value is
# deliberately one of those rejected placeholders.
AUTH_SECRET="replace-with-a-real-32-byte-random-secret"

# --- Session lifetime (optional — all have documented defaults in src/lib/env.ts) ---
# How long a session is valid with no activity at all, in seconds.
# Default: 43200 (12 hours).
AUTH_SESSION_MAX_AGE_SECONDS=43200
# How often an active session's expiry is refreshed ("rolling" expiry), in
# seconds. Default: 3600 (1 hour).
AUTH_SESSION_UPDATE_AGE_SECONDS=3600

# --- Rate limiting (optional — all have documented defaults in src/lib/env.ts) ---
# Login attempts per email address within the window.
RATE_LIMIT_LOGIN_PER_EMAIL_MAX=5
RATE_LIMIT_LOGIN_PER_EMAIL_WINDOW_SECONDS=900
# Login attempts per source IP within the window (looser, since one IP can
# be many legitimate users behind NAT/shared office networks).
RATE_LIMIT_LOGIN_PER_IP_MAX=20
RATE_LIMIT_LOGIN_PER_IP_WINDOW_SECONDS=900
# Registration attempts per email address within the window.
RATE_LIMIT_REGISTER_PER_EMAIL_MAX=5
RATE_LIMIT_REGISTER_PER_EMAIL_WINDOW_SECONDS=3600
# Registration attempts per source IP within the window.
RATE_LIMIT_REGISTER_PER_IP_MAX=10
RATE_LIMIT_REGISTER_PER_IP_WINDOW_SECONDS=3600

// Ethiopian Property Intelligence Platform — Prisma schema
// Task 2: Identity, RBAC, and Location domains.
// Task 5: PropertyType and Property (canonical physical-asset record).
// Listing, PriceHistory, and other future-scope models are not defined here.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Identity
// ---------------------------------------------------------------------------

enum UserStatus {
  active
  suspended
  pending_verification
}

model User {
  id            String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email         String     @unique
  phone         String?    @unique
  passwordHash  String?    @map("password_hash")
  fullName      String     @map("full_name")
  status        UserStatus @default(pending_verification)
  // Bumped whenever all of a user's existing sessions must be invalidated
  // immediately (suspension, forced logout, future password change) —
  // see modules/identity/services/sessionSecurityService.ts. A JWT issued
  // at sign-in embeds the value current at that time; every subsequent
  // request re-checks it against this column, so raising it here revokes
  // every outstanding session for the user without needing a server-side
  // session table.
  securityVersion Int      @default(1) @map("security_version")
  createdAt     DateTime   @default(now()) @map("created_at")
  updatedAt     DateTime   @updatedAt @map("updated_at")

  userRoles UserRole[]
  ownedProperties Property[]
  listings Listing[]
  requestedValuations ValuationReport[]

  @@map("users")
}

// ---------------------------------------------------------------------------
// RBAC — deliberately table-driven (not enums) so new roles and permissions
// can be introduced later as data, without a schema migration.
// ---------------------------------------------------------------------------

model Role {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String   @unique
  description String?
  createdAt   DateTime @default(now()) @map("created_at")

  rolePermissions RolePermission[]
  userRoles       UserRole[]

  @@map("roles")
}

model Permission {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  key         String   @unique
  description String?
  createdAt   DateTime @default(now()) @map("created_at")

  rolePermissions RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       String @map("role_id") @db.Uuid
  permissionId String @map("permission_id") @db.Uuid

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at")

  @@id([roleId, permissionId])
  @@index([permissionId])
  @@map("role_permissions")
}

model UserRole {
  userId String @map("user_id") @db.Uuid
  roleId String @map("role_id") @db.Uuid

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  // Restrict: a role in active use cannot be deleted out from under its
  // holders. Reassign users away from a role first, then delete the role.
  role Role @relation(fields: [roleId], references: [id], onDelete: Restrict)

  assignedAt DateTime @default(now()) @map("assigned_at")

  @@id([userId, roleId])
  @@index([roleId])
  @@map("user_roles")
}

// ---------------------------------------------------------------------------
// Location
//
// Self-referencing hierarchy so depth and level naming can vary by city/
// region without a schema change. `level` is a fixed, small, nationally
// meaningful set of administrative concepts (unlike Role/Permission, which
// are expected to grow arbitrarily) so it is modeled as an enum; adding a
// new level later is an additive migration, not a redesign.
// ---------------------------------------------------------------------------

enum LocationLevel {
  country
  region
  zone
  city
  subcity
  woreda
  kebele
  neighborhood
}

model LocationNode {
  id       String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  parentId String?       @map("parent_id") @db.Uuid
  level    LocationLevel
  name     String
  nameAmharic String?    @map("name_amharic")
  slug     String        @unique

  // PostGIS geometry column. Prisma has no native geometry/geography type,
  // so this is declared Unsupported: the column exists (created via raw SQL
  // in the migration) but Prisma Client cannot read/write it directly.
  // Query/update it via $queryRaw / $executeRaw. Not populated in Task 2.
  boundary Unsupported("geometry(Polygon, 4326)")?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Self-referencing hierarchy. Restrict: a parent with existing children
  // cannot be deleted until its children are reassigned or removed first —
  // prevents silently orphaning part of the location tree.
  parent   LocationNode?  @relation("LocationHierarchy", fields: [parentId], references: [id], onDelete: Restrict)
  children LocationNode[] @relation("LocationHierarchy")
  properties Property[]

  @@index([parentId])
  @@index([level])
  @@map("location_nodes")
}

// ---------------------------------------------------------------------------
// Property
//
// PropertyType is table-driven (like Role/Permission), not an enum — new
// property types are a data change, not a migration. Property is the
// canonical physical-asset record (Phase 1 review's Property/Listing
// split): no price, status, or source/provenance fields live here — those
// belong on Listing (a later task). Deleting a PropertyType or LocationNode
// still in use by a Property is restricted, same pattern as elsewhere in
// this schema.
// ---------------------------------------------------------------------------

model PropertyType {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  key          String   @unique
  label        String
  labelAmharic String?  @map("label_amharic")
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")

  properties Property[]

  @@map("property_types")
}

enum PropertyCondition {
  new
  excellent
  good
  needs_renovation
  under_construction
}

enum ConstructionStatus {
  completed
  under_construction
  planned
}

enum LocationAccuracy {
  exact
  approximate
  unknown
}

enum PropertyVerificationStatus {
  unverified
  agent_submitted
  verified
  disputed
}

// Distinct from PropertyVerificationStatus (a data-quality axis) and from
// a future Listing's commercial status (active/sold/rented/etc. — a
// different axis entirely, once Listing exists). This is the visibility
// lifecycle of the canonical record itself: a property being entered
// isn't ready for search results (draft), becomes visible once complete
// (published), or is retired without being a commercial listing decision
// (archived — e.g. demolished, or consolidated into another record via
// future duplicate-detection).
enum PropertyPublicationStatus {
  draft
  published
  archived
}

model Property {
  id             String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  locationNodeId String @map("location_node_id") @db.Uuid
  propertyTypeId String @map("property_type_id") @db.Uuid
  // The user who created/manages this record. Nullable: not every
  // property will have an individual owner (e.g. future data-ingestion
  // pipelines, or admin-entered records) — see
  // src/modules/property/services/propertyService.ts for how this
  // composes with the RBAC permission check for update/delete.
  ownerUserId String? @map("owner_user_id") @db.Uuid

  publicationStatus PropertyPublicationStatus @default(draft) @map("publication_status")

  // PostGIS geography point (not geometry, unlike LocationNode.boundary):
  // geography makes ST_DWithin(a, b, meters) interpret the distance in
  // real-world meters. On geometry with SRID 4326 (degrees), the same call
  // would silently interpret the distance in degrees instead — wrong for
  // "properties within N km" radius search, which is exactly what this
  // column exists for. Prisma has no native geography type, so this is
  // Unsupported: the column is created via raw SQL in the migration, and
  // read/written via $queryRaw/$executeRaw, not the Prisma Client API.
  coordinates Unsupported("geography(Point, 4326)")?

  // Normalized, not JSONB: these are exactly the columns future market
  // statistics need to filter/aggregate on directly (avg price per sqm by
  // location, avg price by bedroom count, etc. — see Phase 1 review §3).
  landAreaSqm     Decimal? @map("land_area_sqm") @db.Decimal(12, 2)
  buildingAreaSqm Decimal? @map("building_area_sqm") @db.Decimal(12, 2)
  bedrooms        Int?
  bathrooms       Int?
  parkingSpaces   Int?     @map("parking_spaces")
  floor           Int?
  yearBuilt       Int?     @map("year_built")

  condition          PropertyCondition?
  constructionStatus ConstructionStatus? @map("construction_status")

  // Genuinely variable/uncommon attributes only — deliberately not a
  // dumping ground for anything queryable as a market statistic (that
  // belongs in a normalized column above; see Phase 1 review §3).
  extraAttributes Json? @map("extra_attributes")

  // Informal/local addressing (Ethiopian context — structured LocationNode
  // hierarchy alone is not sufficient; see Phase 1 review §4).
  displayAddress     String? @map("display_address")
  landmark           String?
  addressDescription String? @map("address_description")

  // Data-quality fields (Phase 1 review §5/§9) — populated manually or left
  // null for now; no scoring algorithm exists yet, this is architecture
  // only, per the original Task 2 review's explicit instruction not to
  // over-engineer the scoring algorithm before there's real data to
  // validate a formula against.
  completenessScore  Decimal?                    @map("completeness_score") @db.Decimal(3, 2)
  locationAccuracy   LocationAccuracy?           @map("location_accuracy")
  verificationStatus PropertyVerificationStatus  @default(unverified) @map("verification_status")
  lastVerifiedAt     DateTime?                   @map("last_verified_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  locationNode LocationNode @relation(fields: [locationNodeId], references: [id], onDelete: Restrict)
  propertyType PropertyType @relation(fields: [propertyTypeId], references: [id], onDelete: Restrict)
  // Restrict, not Cascade/SetNull: consistent with this schema's general
  // policy of never silently losing the trail of who owns a record. Users
  // are expected to be suspended (User.status), not deleted, so this
  // should not come up in practice; if it ever needs to, reassign
  // ownership first.
  owner        User?        @relation(fields: [ownerUserId], references: [id], onDelete: Restrict)
  listings     Listing[]
  valuationReports ValuationReport[]

  @@index([locationNodeId])
  @@index([propertyTypeId])
  @@index([ownerUserId])
  @@index([landAreaSqm])
  @@index([buildingAreaSqm])
  @@index([bedrooms])
  @@index([publicationStatus])
  @@map("properties")
}

// ---------------------------------------------------------------------------
// Listing
//
// A commercial offer against a Property (Phase 1 review's Property/Listing
// split): a single canonical Property can have zero, one, or many Listings.
// No PropertySource/PriceHistory yet — not part of Task 6's scope, though
// nothing here precludes adding them later (see docs/listing-domain.md).
// ---------------------------------------------------------------------------

enum ListingType {
  sale
  rent
}

enum ListingStatus {
  draft
  active
  sold
  rented
  expired
  archived
}

model Listing {
  id         String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  propertyId String @map("property_id") @db.Uuid
  // The agent/owner responsible for this specific commercial offer —
  // distinct from Property.ownerUserId, since the person listing a
  // property (an agent) isn't necessarily who created the Property
  // record. Required (not nullable, unlike Property.ownerUserId): every
  // Listing in this system is created through an authenticated action,
  // with no data-ingestion path yet that would create one without an
  // acting user.
  agentUserId String @map("agent_user_id") @db.Uuid

  listingType ListingType @map("listing_type")
  price       Decimal     @db.Decimal(14, 2)
  // Plain string, not a Postgres enum — deliberately, per earlier
  // guidance (Phase 1 review): avoid tightly coupling to a fixed
  // ETB/USD pair; adding a currency later should be a data change, not
  // a migration. Validated against a small allow-list in Zod, not here.
  currency    String      @default("ETB") @db.VarChar(3)
  negotiable  Boolean     @default(false)
  status      ListingStatus @default(draft)
  contactInfo Json?       @map("contact_info")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Restrict, not Cascade: consistent with every other relation in this
  // schema — deleting a Property or User that still has Listings
  // attached must not silently destroy commercial-offer history.
  property Property @relation(fields: [propertyId], references: [id], onDelete: Restrict)
  agent    User     @relation(fields: [agentUserId], references: [id], onDelete: Restrict)

  @@index([propertyId])
  @@index([agentUserId])
  // Composite index for the commercial search path: filtering/sorting by
  // status + listingType + price together is the primary query shape for
  // "active sale listings under X price," etc.
  @@index([status, listingType, price])
  @@map("listings")
}

// ---------------------------------------------------------------------------
// ValuationReport
//
// An automated (or, later, professional) market valuation for a Property.
// Deliberately NOT created for every estimation request: when there is
// genuinely no comparable market data to base a number on, the service
// returns a structured "insufficient data" result instead of persisting a
// fabricated estimate — see docs/valuation-domain.md §1. Every row that
// does exist here represents a real, computed estimate, even if a
// low-confidence, wide-range one.
// ---------------------------------------------------------------------------

enum ValuationMethodology {
  comparable_sales
  cost_approach
  hybrid
}

enum ValuationStatus {
  draft
  completed
  archived
}

model ValuationReport {
  id         String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  propertyId String  @map("property_id") @db.Uuid
  // Nullable: the estimate endpoint supports anonymous, rate-limited
  // requests (see docs/valuation-domain.md §2) — not every report has a
  // requesting user to attribute it to.
  requestedByUserId String? @map("requested_by_user_id") @db.Uuid

  estimatedValue  Decimal @map("estimated_value") @db.Decimal(16, 2)
  lowEstimate     Decimal @map("low_estimate") @db.Decimal(16, 2)
  highEstimate    Decimal @map("high_estimate") @db.Decimal(16, 2)
  // 0.00-1.00, enforced by both this precision and a CHECK constraint
  // (see migration) — sample-size- and variance-driven, computed by
  // modules/valuation/services/valuationService.ts, never hand-set.
  confidenceScore Decimal @map("confidence_score") @db.Decimal(3, 2)

  methodology ValuationMethodology @default(comparable_sales)
  status      ValuationStatus      @default(completed)

  // Reserved for a future real AI-model call (Gemini or otherwise, per
  // the Phase 0 AI-architecture principle of an interchangeable
  // provider) — unused by Task 7's purely statistical engine. Present
  // now so adding that integration later doesn't require a migration.
  rawAiResponse Json? @map("raw_ai_response")
  // Comparable listing IDs, per-comparable price-per-sqm, adjustment
  // multipliers applied, and sample statistics — the full "show your
  // work" record backing estimatedValue/low/high, per Task 7's spec.
  valuationData Json? @map("valuation_data")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  property    Property @relation(fields: [propertyId], references: [id], onDelete: Restrict)
  requestedBy User?    @relation(fields: [requestedByUserId], references: [id], onDelete: Restrict)

  // Historical valuation tracking for a property: "every estimate ever
  // produced for this property, most recent first" is the primary access
  // pattern, per Task 7's spec.
  @@index([propertyId, createdAt])
  @@index([requestedByUserId])
  @@map("valuation_reports")
}

// ---------------------------------------------------------------------------
// Rate limiting
//
// Deliberately backed by Postgres rather than an in-process counter or a
// new piece of infrastructure (e.g. Redis): every application instance
// already talks to this same database, so a shared, atomically-updated
// table gives correct behavior across multiple instances with no new
// infrastructure to run and secure. See lib/rate-limit/ for the
// interface/implementation and the trade-offs of this choice.
// ---------------------------------------------------------------------------

model RateLimitBucket {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  // e.g. "login:email:user@example.com" or "register:ip:203.0.113.4" —
  // the caller defines the key's namespace; this table has no opinion on it.
  key         String
  // Fixed-window bucketing: the window a given attempt falls into, computed
  // as floor(now / windowSizeMs) * windowSizeMs. (key, windowStart) is
  // unique, so concurrent requests across instances increment the same row
  // via an atomic upsert rather than racing on separate counters.
  windowStart DateTime @map("window_start")
  count       Int      @default(0)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@unique([key, windowStart])
  @@index([key])
  @@map("rate_limit_buckets")
}
